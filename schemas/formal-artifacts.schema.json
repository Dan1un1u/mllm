{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "roles",
          "artifact_role",
          "root_windows",
          "relative_path",
          "size_bytes",
          "sha256",
          "required"
        ],
        "properties": {
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "archived_reference",
                "performance_comparator",
                "selected_w4a8_baseline"
              ]
            }
          },
          "artifact_role": {"type": "string"},
          "root_windows": {"pattern": "^[A-Z]:\\\\.+$"},
          "relative_path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"pattern": "^[0-9a-f]{64}$"},
          "required": {"type": "boolean"}
        }
      }
    }
  }
}
